# copy to .env and fill in. never commit .env.

# --- project ---
ENV=development
PROJECT_NAME=base-product
LOG_LEVEL=INFO

# --- provider ---
# one of: openai | gemini | local | mock
# openai, gemini and local servers (vllm, ollama, tgi) share one wire format,
# so switching provider means changing these values, not the code.
PROVIDER=mock
API_BASE_URL=
API_KEY=
MODEL=
EMBED_MODEL=
REQUEST_TIMEOUT_S=60
MAX_RETRIES=2
TEMPERATURE=0.2
MAX_TOKENS=1024

# provider presets (used when API_BASE_URL is empty)
# openai  -> https://api.openai.com/v1                                      key: OPENAI_API_KEY
# gemini  -> https://generativelanguage.googleapis.com/v1beta/openai/       key: GEMINI_API_KEY
# local   -> http://localhost:8000/v1                                       key: LOCAL_API_KEY
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# LOCAL_API_KEY=

# --- serving ---
API_HOST=0.0.0.0
API_PORT=8000
# when set, requests must send x-api-key
INBOUND_API_KEY=

# --- rag ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# --- eval gate (set your bar later) ---
# EVAL_MIN_PASS_RATE=0.8
# EVAL_MAX_P95_MS=5000

# --- cost tracking (usd per 1k tokens) ---
COST_PER_1K_INPUT=0.0
COST_PER_1K_OUTPUT=0.0
